# Copy to .env.local and fill in real values.

# Session encryption — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-char-random-string-XXXXXXXXX

# Master password (bcrypt hash). Use: pnpm tsx scripts/hash-password.ts "yourpass"
ADMIN_PASSWORD_HASH=
MARKETING_PASSWORD_HASH=

# Anthropic API key for the Claude chat tab (optional — chat disabled if empty)
ANTHROPIC_API_KEY=

# Google Sheets — only needed for import/sync
TULIP_SHEET_ID=1ZYJKkgDx34TPCOgmMDtG26LD_T22OPlcjOMdqgtyvIg

# Notification email recipient for "lead activity" alerts (optional)
NOTIFY_EMAIL=

# Local DB location (default: data/crm.db). Don't change after first init.
DB_PATH=data/crm.db
